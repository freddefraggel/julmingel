# Firebase-webbkonfigurationen för det riktiga projektet. Värdena är publika.
# Kopiera till .env.local (ignoreras av git) för att bygga eller köra
# npm run dev med VITE_FIREBASE_EMULATOR=false mot det riktiga projektet.
# I GitHub Actions kommer värdena från repo-variablerna FIREBASE_*.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
