{
  "rules": {
    "admins": {
      ".read": false,
      ".write": false
    },
    "eventIndex": {
      ".read": "root.child('admins/' + auth.uid).exists()",
      ".write": "root.child('admins/' + auth.uid).exists()",
      "$e": {
        ".validate": "newData.hasChild('name') && $e.matches(/^[a-z0-9][a-z0-9-]{1,39}$/)",
        "name": {
          ".validate": "newData.isString()"
        }
      }
    },
    "events": {
      "$e": {
        ".read": "root.child('admins/' + auth.uid).exists()",
        ".write": "root.child('admins/' + auth.uid).exists()",

        "config": {
          ".read": "data.parent().child('guests/' + auth.uid).exists()",
          "joinOpen": {
            ".read": "auth != null"
          },
          "name": {
            ".read": "auth != null"
          }
        },
        "assets": {
          ".read": "data.parent().child('guests/' + auth.uid).exists()",
          "$imageId": {
            ".validate": "newData.isString() && newData.val().length <= 200000 && (newData.val().beginsWith('data:image/') || newData.val().beginsWith('https://'))"
          }
        },
        "secret": {
          "quizTimes": {
            "$q": {
              ".validate": "newData.hasChildren(['openedAt', 'durationMs'])",
              "openedAt": {
                ".validate": "newData.val() === now || newData.val() === data.val()"
              },
              "durationMs": {
                ".validate": "newData.isNumber() && newData.val() > 0"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "live": {
          ".read": "data.parent().child('guests/' + auth.uid).exists()",
          "stage": {
            ".validate": "newData.val() === 'lobby' || newData.val() === 'evening' || newData.val() === 'wrapup' || newData.val() === 'done'"
          },
          "tasting": {
            "$class": {
              ".validate": "$class === 'vanlig' || $class === 'alkfri'",
              "open": {
                ".validate": "newData.isBoolean()"
              }
            }
          },
          "quiz": {
            ".validate": "newData.hasChild('state') && (newData.child('state').val() !== 'open' || (newData.hasChildren(['qId', 'openedAt', 'durationMs']) && newData.child('openedAt').val() === newData.parent().parent().child('secret/quizTimes/' + newData.child('qId').val() + '/openedAt').val() && newData.child('durationMs').val() === newData.parent().parent().child('secret/quizTimes/' + newData.child('qId').val() + '/durationMs').val()))",
            "state": {
              ".validate": "newData.val() === 'idle' || newData.val() === 'playing' || newData.val() === 'open' || newData.val() === 'closed'"
            }
          },
          "wrapup": {
            "step": {
              ".validate": "newData.val() === 'review' || newData.val() === 'guess' || newData.val() === 'reveal'"
            },
            "revealStep": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4 && newData.val() % 1 === 0"
            }
          }
        },
        "reveal": {
          ".read": "data.parent().child('guests/' + auth.uid).exists()"
        },
        "results": {
          ".read": "data.parent().child('guests/' + auth.uid).exists()"
        },

        "guests": {
          "$uid": {
            ".read": "auth.uid === $uid",
            ".write": "auth.uid === $uid && !data.exists() && root.child('events/' + $e + '/config/joinOpen').val() === true",
            ".validate": "newData.hasChildren(['name', 'class', 'joinCode', 'joinedAt']) && (newData.child('joinCode').val() === root.child('events/' + $e + '/secret/joinCode').val() || (data.exists() && newData.child('joinCode').val() === data.child('joinCode').val()))",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
            },
            "class": {
              ".validate": "newData.val() === 'vanlig' || newData.val() === 'alkfri'"
            },
            "joinCode": {
              ".validate": "newData.isString()"
            },
            "joinedAt": {
              ".validate": "newData.val() === now || (data.exists() && newData.val() === data.val())"
            },
            "$other": {
              ".validate": false
            }
          }
        },

        "ratings": {
          "$uid": {
            ".read": "auth.uid === $uid",
            "$number": {
              "$cId": {
                ".write": "auth.uid === $uid && root.child('events/' + $e + '/live/tasting/' + root.child('events/' + $e + '/guests/' + $uid + '/class').val() + '/open').val() === true",
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5 && newData.val() % 1 === 0 && root.child('events/' + $e + '/config/criteria/' + $cId).exists() && root.child('events/' + $e + '/secret/numbers/' + root.child('events/' + $e + '/guests/' + $uid + '/class').val() + '/' + $number).exists()"
              }
            }
          }
        },

        "answers": {
          "$q": {
            "$uid": {
              ".read": "auth.uid === $uid",
              ".write": "auth.uid === $uid && root.child('events/' + $e + '/guests/' + $uid).exists() && root.child('events/' + $e + '/live/quiz/state').val() === 'open' && root.child('events/' + $e + '/live/quiz/qId').val() === $q && now <= root.child('events/' + $e + '/live/quiz/openedAt').val() + root.child('events/' + $e + '/live/quiz/durationMs').val()",
              ".validate": "newData.hasChildren(['choice', 'at'])",
              "choice": {
                ".validate": "newData.isString() && newData.val().matches(/^[ABCD]$/)"
              },
              "at": {
                ".validate": "newData.val() === now"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },

        "guesses": {
          "$uid": {
            ".read": "auth.uid === $uid",
            ".write": "auth.uid === $uid && root.child('events/' + $e + '/guests/' + $uid).exists() && root.child('events/' + $e + '/live/wrapup/step').val() === 'guess' && data.child('locked').val() !== true",
            ".validate": "newData.hasChildren(['locked'])",
            "map": {
              "$number": {
                ".validate": "newData.isString() && root.child('events/' + $e + '/config/gloggs/' + newData.val() + '/class').val() === root.child('events/' + $e + '/guests/' + $uid + '/class').val() && root.child('events/' + $e + '/secret/numbers/' + root.child('events/' + $e + '/guests/' + $uid + '/class').val() + '/' + $number).exists()"
              }
            },
            "locked": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
