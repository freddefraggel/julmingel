{
  "name": "julmingel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n firebase,vite,seed -c yellow,cyan,green \"npm:emulators\" \"npm:dev:web\" \"npm:seed\"",
    "dev:web": "vite",
    "emulators": "firebase emulators:start --project demo-glogg-mingel",
    "seed": "node scripts/seed-emulator.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --project demo-glogg-mingel --only database \"vitest run --config vitest.rules.config.ts\"",
    "deploy:rules": "firebase deploy --only database"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "firebase": "^13.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "firebase-tools": "^15.37.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
